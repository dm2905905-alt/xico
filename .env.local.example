# Copia este archivo como .env.local y pega los datos de tu app web de Firebase:
# Firebase Console → ⚙️ Configuración del proyecto → General → Tus apps → SDK setup and configuration → Config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Solo servidor (SECRETOS: nunca empiezan con NEXT_PUBLIC_) ---
# Cuenta de servicio de Firebase en base64 (Firebase → ⚙️ → Cuentas de servicio → Generar nueva clave privada)
FIREBASE_SERVICE_ACCOUNT=
# Access Token de Mercado Pago (Developers → Tus integraciones → Credenciales). De prueba empieza con TEST-
MP_ACCESS_TOKEN=
# Dirección pública del sitio (en tu computadora: http://localhost:3000)
SITE_URL=http://localhost:3000
